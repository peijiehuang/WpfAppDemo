<Window x:Class="WpfAppDemo.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:common="clr-namespace:WpfAppDemo.Common"
        mc:Ignorable="d"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{DynamicResource Login_Title}" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Border CornerRadius="20" Background="{DynamicResource MaterialDesignPaper}" Margin="10" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Direction="-90" RenderingBias="Quality" ShadowDepth="2" Opacity="0.3"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Side: Introduction -->
            <Border Grid.Column="0" CornerRadius="20,0,0,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#673AB7" Offset="0"/> <!-- DeepPurple Primary -->
                        <GradientStop Color="#9575CD" Offset="1"/> <!-- DeepPurple Light -->
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel VerticalAlignment="Center" Margin="60">
                    <materialDesign:PackIcon Kind="RocketLaunch" Width="90" Height="90" 
                                             Foreground="White" HorizontalAlignment="Left" Margin="0,0,0,32"/>

                    <TextBlock 
                               FontSize="48" FontWeight="ExtraBold" Foreground="White" 
                               Margin="0,0,0,8">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.3"/>
                        </TextBlock.Effect><Run Language="zh-cn" Text="Demo"/></TextBlock>

                    <TextBlock Text="{DynamicResource Login_ProductSubTitle}" 
                               FontSize="18" FontWeight="SemiBold" Foreground="White" 
                               Opacity="0.8" Margin="0,0,0,32"/>

                    <Border Height="2" Width="60" Background="White" HorizontalAlignment="Left" Opacity="0.5" Margin="0,0,0,32"/>

                    <TextBlock Text="{DynamicResource Login_ProductDesc}" 
                               Foreground="White" Opacity="0.75" TextWrapping="Wrap" 
                               LineHeight="28" FontSize="18" FontWeight="Light"/>
                </StackPanel>
            </Border>

            <!-- Right Side: Login Form -->
            <Grid Grid.Column="1">
                <materialDesign:PopupBox Style="{DynamicResource MaterialDesignPopupBox}" 
                                         HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Margin="16" ToolTip="{DynamicResource Shell_SwitchLanguage}">
                    <StackPanel>
                        <Button Content="中文 (简体)" Command="{Binding SwitchLanguageCommand}" CommandParameter="zh-CN"/>
                        <Button Content="English (US)" Command="{Binding SwitchLanguageCommand}" CommandParameter="en-US"/>
                    </StackPanel>
                </materialDesign:PopupBox>

                <StackPanel Margin="40" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Login_SignIn}" Style="{StaticResource MaterialDesignHeadline4TextBlock}" 
                               FontWeight="Medium" Margin="0,0,0,32"/>

                <TextBox materialDesign:HintAssist.Hint="{DynamicResource Login_Username}" 
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,24">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding LoginCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <PasswordBox x:Name="PasswordBox" materialDesign:HintAssist.Hint="{DynamicResource Login_Password}" 
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             common:PasswordBoxHelper.Attach="True"
                             common:PasswordBoxHelper.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             Margin="0,0,0,8">
                    <PasswordBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding LoginCommand}"/>
                    </PasswordBox.InputBindings>
                </PasswordBox>
                
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontSize="12" 
                           HorizontalAlignment="Left" Margin="0,0,0,16"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                <Button Command="{Binding LoginCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Content="{DynamicResource Login_BtnLogin}" Height="45"
                        materialDesign:ButtonAssist.CornerRadius="8"
                        Margin="0,24,0,0"/>
                
                <Button Content="{DynamicResource Login_BtnExit}" Style="{StaticResource MaterialDesignFlatButton}" 
                        Margin="0,16,0,0" HorizontalAlignment="Center"
                        Click="ExitButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
