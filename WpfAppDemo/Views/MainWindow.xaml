<Window x:Class="WpfAppDemo.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:prism="http://prismlibrary.com/"
        mc:Ignorable="d"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{DynamicResource Shell_Title}" Height="800" Width="1200"
        Visibility="Collapsed"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <materialDesign:DialogHost Identifier="RootDialog">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar Navigation -->
            <Border Grid.Column="0" Background="{DynamicResource MaterialDesignPaper}" 
                    BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Brand/Logo Area -->
                    <StackPanel DockPanel.Dock="Top" Margin="24,40,16,40" Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="RocketLaunch" Width="40" Height="40" 
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Shell_Title}" Margin="16,0,0,0" 
                                   VerticalAlignment="Center" FontWeight="Black" FontSize="20"
                                   Foreground="{DynamicResource MaterialDesignBody}"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                    </StackPanel>

                    <!-- Bottom Actions (Docked first to bottom) -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,24">
                        <Separator Margin="8,0,8,16" Style="{StaticResource MaterialDesignLightSeparator}" Opacity="0.5"/>
                        <Button Command="{Binding LogoutCommand}" Style="{StaticResource MaterialDesignFlatButton}" 
                                Foreground="{DynamicResource MaterialDesignBodyLight}"
                                HorizontalContentAlignment="Left" Padding="16,10">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Logout" Width="24" Height="24" Margin="0,0,16,0"/>
                                <TextBlock Text="{DynamicResource Shell_Logout}" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Navigation Menu -->
                    <ListBox ItemsSource="{Binding MenuItems}" SelectedItem="{Binding SelectedMenuItem}"
                             Style="{StaticResource MaterialDesignNavigationPrimaryListBox}"
                             Background="Transparent" Margin="8,0">
                        <ListBox.Resources>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignNavigationPrimaryListBoxItem}">
                                <Setter Property="Margin" Value="0,4"/>
                                <Setter Property="Padding" Value="16,12"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="{Binding Icon}" Width="24" Height="24" Margin="0,0,20,0"/>
                                    <TextBlock Text="{Binding Title, Converter={StaticResource ResourceStringConverter}}" 
                                               VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right Content Area -->
            <DockPanel Grid.Column="1">
                <!-- Top Header Bar (Modern Elevated Look) -->
                <materialDesign:ColorZone Padding="24,12" materialDesign:ElevationAssist.Elevation="Dp1" 
                                          Mode="Standard" DockPanel.Dock="Top">
                    <DockPanel>
                        <TextBlock VerticalAlignment="Center" Text="{Binding SelectedMenuItem.Title, Converter={StaticResource ResourceStringConverter}}" 
                                   Style="{StaticResource MaterialDesignHeadline5TextBlock}" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesignBody}"/>

                        <!-- Right Side Actions -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Command="{Binding ToggleThemeCommand}"
                                    Style="{DynamicResource MaterialDesignIconButton}"
                                    ToolTip="{DynamicResource Shell_ToggleTheme}"
                                    Foreground="{DynamicResource PrimaryHueMidBrush}">
                                <materialDesign:PackIcon Kind="ThemeLightDark" Width="24" Height="24"/>
                            </Button>

                            <materialDesign:PopupBox Style="{DynamicResource MaterialDesignPopupBox}" 
                                                     PlacementMode="BottomAndAlignRightEdges"
                                                     ToolTip="{DynamicResource Shell_SwitchLanguage}" Margin="8,0,0,0"
                                                     Foreground="{DynamicResource MaterialDesignBody}">
                                <StackPanel>
                                    <Button Content="中文 (简体)" Command="{Binding SwitchLanguageCommand}" CommandParameter="zh-CN"/>
                                    <Button Content="English (US)" Command="{Binding SwitchLanguageCommand}" CommandParameter="en-US"/>
                                </StackPanel>
                            </materialDesign:PopupBox>
                        </StackPanel>
                    </DockPanel>
                </materialDesign:ColorZone>

                <!-- Page Content Region -->
                <ContentControl prism:RegionManager.RegionName="ContentRegion" Margin="0" />
            </DockPanel>

            <!-- Global Busy Overlay -->
            <Grid x:Name="BusyOverlay" Grid.ColumnSpan="2" 
                  Visibility="{Binding BusyService.IsBusy, Converter={StaticResource StringToVisibilityConverter}}"
                  Background="#44000000">
                <materialDesign:Card Padding="24" materialDesign:ElevationAssist.Elevation="Dp8" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Orientation="Vertical">
                        <ProgressBar Style="{DynamicResource MaterialDesignCircularProgressBar}" 
                                     Value="0" IsIndeterminate="True" 
                                     Width="48" Height="48" Margin="0,0,0,16"/>
                        <TextBlock Text="{Binding BusyService.Message}" 
                                   Visibility="{Binding BusyService.Message, Converter={StaticResource StringToVisibilityConverter}}"
                                   Style="{StaticResource MaterialDesignBody1TextBlock}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Window>
