<UserControl x:Class="WpfAppDemo.Views.CodeGenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Selection Card -->
        <materialDesign:Card Padding="16" Margin="0,0,0,16" materialDesign:ElevationAssist.Elevation="Dp2">
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Tables}" 
                          SelectedItem="{Binding SelectedTable}" 
                          materialDesign:HintAssist.Hint="{DynamicResource CodeGen_SelectTable}" 
                          Style="{StaticResource MaterialDesignFloatingHintComboBox}" 
                          Width="350" Margin="0,0,24,0"/>
                <Button Command="{Binding SaveToDiskCommand}" 
                        Content="{DynamicResource CodeGen_Export}" 
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- Main Content Tabs -->
        <materialDesign:Card Grid.Row="1" materialDesign:ElevationAssist.Elevation="Dp2">
            <TabControl Style="{StaticResource MaterialDesignNavigationRailTabControl}" 
                        TabStripPlacement="Left" 
                        materialDesign:ColorZoneAssist.Mode="PrimaryMid">
                
                <!-- Tab 1: Instructions -->
                <TabItem Header="{DynamicResource CodeGen_Instructions}">
                    <DockPanel Margin="24">
                        <materialDesign:ColorZone DockPanel.Dock="Top" Mode="PrimaryLight" Padding="16" CornerRadius="4" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="HelpCircle" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource CodeGen_Instructions}" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </materialDesign:ColorZone>
                        <TextBox Text="{Binding UsageInstructions}" 
                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontSize="14"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </DockPanel>
                </TabItem>

                <!-- Tab 2: Code Files -->
                <TabItem Header="{DynamicResource CodeGen_Preview}">
                    <Grid>
                        <TabControl ItemsSource="{Binding GeneratedFiles}" 
                                    Style="{StaticResource MaterialDesignTabControl}"
                                    Margin="16">
                            <TabControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Margin="4,0"/>
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,16,0,0">
                                        <materialDesign:ColorZone DockPanel.Dock="Top" Mode="Light" Padding="12,8" CornerRadius="4" Margin="0,0,0,12" materialDesign:ElevationAssist.Elevation="Dp1">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="FileCodeOutline" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{DynamicResource CodeGen_Path}" VerticalAlignment="Center" FontWeight="Bold"/>
                                                    <TextBox Text="{Binding Path}" IsReadOnly="True" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" Margin="4,0"/>
                                                </StackPanel>
                                                <Button HorizontalAlignment="Right" 
                                                        Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding Path}" 
                                                        Style="{StaticResource MaterialDesignIconButton}" Width="30" Height="30">
                                                    <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16"/>
                                                </Button>
                                            </Grid>
                                        </materialDesign:ColorZone>
                                        <Grid>
                                            <TextBox Text="{Binding Content}" 
                                                     IsReadOnly="True" AcceptsReturn="True" 
                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
                                                     FontFamily="Consolas" 
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,16,0" 
                                                    Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding Content}" 
                                                    Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryButton}" 
                                                    ToolTip="{DynamicResource CodeGen_Copy}">
                                                <materialDesign:PackIcon Kind="ContentCopy" Width="20" Height="20"/>
                                            </Button>
                                        </Grid>
                                    </DockPanel>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    </Grid>
                </TabItem>
            </TabControl>
        </materialDesign:Card>
    </Grid>
</UserControl>
