<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    
    <!-- ============================================================================== -->
    <!-- 登录界面资源 (Login Page) -->
    <!-- ============================================================================== -->
    <sys:String x:Key="Login_Title">登录</sys:String>
    <sys:String x:Key="Login_Welcome">欢迎回来</sys:String>
    <sys:String x:Key="Login_ProductTitle">WPF 快速开发模板</sys:String>
    <sys:String x:Key="Login_ProductSubTitle">WPF 优雅开发框架示例</sys:String>
    <sys:String x:Key="Login_ProductDesc">体验 Prism、Material Design 和 SqlSugar 的完美融合。比以往更快速地构建企业级桌面应用。</sys:String>
    <sys:String x:Key="Login_SignIn">登录系统</sys:String>
    <sys:String x:Key="Login_Username">用户名</sys:String>
    <sys:String x:Key="Login_Password">密码</sys:String>
    <sys:String x:Key="Login_BtnLogin">登录</sys:String>
    <sys:String x:Key="Login_BtnExit">退出程序</sys:String>
    <sys:String x:Key="Login_Error">用户名或密码错误。</sys:String>

    <!-- ============================================================================== -->
    <!-- 外壳与导航资源 (Main Shell & Navigation) -->
    <!-- ============================================================================== -->
    <sys:String x:Key="Shell_Title">WPF Material Design &amp; Prism 架构演示</sys:String>
    <sys:String x:Key="Shell_MenuTitle">功能菜单</sys:String>
    <sys:String x:Key="Shell_Dashboard">仪表盘</sys:String>
    <sys:String x:Key="Shell_Users">用户管理</sys:String>
    <sys:String x:Key="Shell_SwitchLanguage">切换语言</sys:String>
    <sys:String x:Key="Shell_Logout">注销登录</sys:String>
    <sys:String x:Key="Shell_ToggleTheme">切换主题</sys:String>
    <sys:String x:Key="Shell_CodeGen">代码生成器</sys:String>
    <sys:String x:Key="Menu_TEST">测试管理</sys:String>

    <!-- ============================================================================== -->
    <!-- 控制面板资源 (Dashboard) -->
    <!-- ============================================================================== -->
    <sys:String x:Key="Dashboard_Welcome">欢迎使用 WPF 快速开发通用模板</sys:String>
    <sys:String x:Key="Dashboard_SubTitle">基于 Prism 框架 + Material Design 设计</sys:String>

    <!-- ============================================================================== -->
    <!-- 用户管理模块 (User Management) -->
    <!-- ============================================================================== -->
    <sys:String x:Key="User_Title">用户管理</sys:String>
    <sys:String x:Key="User_BtnAdd">新增用户</sys:String>
    <sys:String x:Key="User_HeaderUsername">用户名</sys:String>
    <sys:String x:Key="User_HeaderName">姓名</sys:String>
    <sys:String x:Key="User_HeaderEmail">邮箱</sys:String>
    <sys:String x:Key="User_HeaderRole">角色</sys:String>
    <sys:String x:Key="User_HeaderActions">操作</sys:String>

    <sys:String x:Key="User_EditTitle">编辑用户</sys:String>
    <sys:String x:Key="User_AddTitle">新增用户</sys:String>
    <sys:String x:Key="User_HintUsername">请输入用户名</sys:String>
    <sys:String x:Key="User_HintPassword">请输入密码</sys:String>
    <sys:String x:Key="User_HintName">完整姓名</sys:String>
    <sys:String x:Key="User_HintEmail">电子邮箱地址</sys:String>
    <sys:String x:Key="User_HintRole">角色权限</sys:String>
    <sys:String x:Key="User_BtnSave">保存资料</sys:String>
    <sys:String x:Key="User_BtnCancel">放弃更改</sys:String>

    <!-- ============================================================================== -->
    <!-- 通用全局资源 (Common / Global) -->
    <!-- ============================================================================== -->
    <sys:String x:Key="Common_Confirm">确定</sys:String>
    <sys:String x:Key="Common_Cancel">取消</sys:String>
    <sys:String x:Key="Common_Save">保存</sys:String>
    <sys:String x:Key="Common_Delete">删除</sys:String>
    <sys:String x:Key="Common_Info">系统提示</sys:String>
    <sys:String x:Key="Common_Warning">操作警告</sys:String>
    <sys:String x:Key="Common_Error">错误异常</sys:String>
    <sys:String x:Key="Common_DeleteConfirm">删除确认</sys:String>
    <sys:String x:Key="Common_DeleteMessage">确定要彻底删除这条记录吗? 此操作不可撤销。</sys:String>
    <sys:String x:Key="Common_Loading">正在努力加载中...</sys:String>
    <sys:String x:Key="Common_Add">添加</sys:String>
    <sys:String x:Key="Common_ExportExcel">导出 Excel</sys:String>
    <sys:String x:Key="Common_ExportSuccess">数据已成功导出至本地文件夹</sys:String>

    <!-- ============================================================================== -->
    <!-- 代码生成器 (Code Generator) -->
    <!-- ============================================================================== -->
    <sys:String x:Key="CodeGen_SelectTable">1. 选择数据库表 (自动生成代码预览)</sys:String>
    <sys:String x:Key="CodeGen_Export">2. 导出所有生成的代码文件</sys:String>
    <sys:String x:Key="CodeGen_Instructions">集成指引说明</sys:String>
    <sys:String x:Key="CodeGen_Preview">源码实时预览</sys:String>
    <sys:String x:Key="CodeGen_Path">推荐存储路径: </sys:String>
    <sys:String x:Key="CodeGen_Copy">点击复制代码</sys:String>

</ResourceDictionary>
