<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Login Page -->
    <sys:String x:Key="Login_Title">Login</sys:String>
    <sys:String x:Key="Login_Welcome">Welcome Back</sys:String>
    <sys:String x:Key="Login_ProductTitle">ANTIGRAVITY</sys:String>
    <sys:String x:Key="Login_ProductSubTitle">WPF SCAFFOLDING</sys:String>
    <sys:String x:Key="Login_ProductDesc">Experience the perfect synergy of Prism, Material Design, and SqlSugar. Build enterprise-grade desktop applications with unmatched speed and elegance.</sys:String>
    <sys:String x:Key="Login_SignIn">Sign In</sys:String>
    <sys:String x:Key="Login_Username">Username</sys:String>
    <sys:String x:Key="Login_Password">Password</sys:String>
    <sys:String x:Key="Login_BtnLogin">LOG IN</sys:String>
    <sys:String x:Key="Login_BtnExit">Exit Application</sys:String>
    <sys:String x:Key="Login_Error">Invalid username or password.</sys:String>

    <!-- Main Shell -->
    <sys:String x:Key="Shell_Title">WPF Material Design &amp; Prism Demo</sys:String>
    <sys:String x:Key="Shell_MenuTitle">App Menu</sys:String>
    <sys:String x:Key="Shell_Dashboard">Dashboard</sys:String>
    <sys:String x:Key="Shell_Users">Users</sys:String>
    <sys:String x:Key="Shell_SwitchLanguage">Language</sys:String>
    <sys:String x:Key="Shell_Logout">Sign Out</sys:String>
    <sys:String x:Key="Shell_ToggleTheme">Toggle Theme</sys:String>
    <sys:String x:Key="Shell_CodeGen">Code Generator</sys:String>
    <sys:String x:Key="Menu_TEST">TEST Management</sys:String>

    <!-- Dashboard -->
    <sys:String x:Key="Dashboard_Welcome">Welcome to WPF Scaffolding</sys:String>
    <sys:String x:Key="Dashboard_SubTitle">Built with Prism Framework + Material Design</sys:String>

    <!-- User Management -->
    <sys:String x:Key="User_Title">User Management</sys:String>
    <sys:String x:Key="User_BtnAdd">ADD USER</sys:String>
    <sys:String x:Key="User_HeaderUsername">Username</sys:String>
    <sys:String x:Key="User_HeaderName">Name</sys:String>
    <sys:String x:Key="User_HeaderEmail">Email</sys:String>
    <sys:String x:Key="User_HeaderRole">Role</sys:String>
    <sys:String x:Key="User_HeaderActions">Actions</sys:String>

    <!-- User Edit -->
    <sys:String x:Key="User_EditTitle">Edit User</sys:String>
    <sys:String x:Key="User_AddTitle">Add User</sys:String>
    <sys:String x:Key="User_HintUsername">Username</sys:String>
    <sys:String x:Key="User_HintPassword">Password</sys:String>
    <sys:String x:Key="User_HintName">Full Name</sys:String>
    <sys:String x:Key="User_HintEmail">Email Address</sys:String>
    <sys:String x:Key="User_HintRole">Role</sys:String>
    <sys:String x:Key="User_BtnSave">SAVE</sys:String>
    <sys:String x:Key="User_BtnCancel">CANCEL</sys:String>
    <!-- Common / Global -->
    <sys:String x:Key="Common_Confirm">CONFIRM</sys:String>
    <sys:String x:Key="Common_Cancel">CANCEL</sys:String>
    <sys:String x:Key="Common_Save">SAVE</sys:String>
    <sys:String x:Key="Common_Delete">DELETE</sys:String>
    <sys:String x:Key="Common_Info">Information</sys:String>
    <sys:String x:Key="Common_Warning">Warning</sys:String>
    <sys:String x:Key="Common_Error">Error</sys:String>
    <sys:String x:Key="Common_DeleteConfirm">Delete Confirm</sys:String>
    <sys:String x:Key="Common_DeleteMessage">Are you sure you want to delete this record?</sys:String>
    <sys:String x:Key="Common_Loading">Loading...</sys:String>

    <!-- CodeGen -->
    <sys:String x:Key="CodeGen_SelectTable">1. Select Table (Auto Preview)</sys:String>
    <sys:String x:Key="CodeGen_Export">2. Export All Source Files</sys:String>
    <sys:String x:Key="CodeGen_Instructions">Instructions</sys:String>
    <sys:String x:Key="CodeGen_Preview">Code Preview</sys:String>
    <sys:String x:Key="CodeGen_Path">Target Path: </sys:String>
    <sys:String x:Key="CodeGen_Copy">Copy Content</sys:String>
</ResourceDictionary>
